# Salin ke .env.local, isi dengan nilai proyek Supabase Tuan.
# JANGAN commit .env.local. JANGAN pakai secret key di sini.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Isi SALAH SATU kunci di bawah (keduanya diterima kode):
# - Nama lama: NEXT_PUBLIC_SUPABASE_ANON_KEY
# - Nama baru di dashboard Supabase: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (kunci publishable)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opsional: origin publik aplikasi, dipakai sebagai fallback redirect
# verifikasi email bila header origin tidak tersedia.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opsional: URL service Python Engine (default http://127.0.0.1:8010).
# ENGINE_SERVICE_URL=http://127.0.0.1:8010
